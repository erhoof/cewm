+/* symvm: true when translated blocks exist on this (ram_addr space) page */
+bool page_has_tbs(struct uc_struct *uc, ram_addr_t addr)
+{
+    PageDesc *p = page_find(uc, addr >> TARGET_PAGE_BITS);
+    return p && p->first_tb;
+}
