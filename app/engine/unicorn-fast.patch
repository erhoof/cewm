diff --git a/qemu/accel/tcg/translator.c b/qemu/accel/tcg/translator.c
index 72f21c4..130606d 100644
--- a/qemu/accel/tcg/translator.c
+++ b/qemu/accel/tcg/translator.c
@@ -32,6 +32,30 @@ void translator_loop_temp_check(DisasContextBase *db)
 #endif
 }
 
+/* symvm: the embedder's block clock lives in two host words {count, limit}. Each block adds its cost inline and calls the block hook only when count >= limit
+   (the embedder sets limit to the slice budget, or to 0 to see every block). */
+uint64_t *symvm_ctr;
+int symvm_exact_clock;   /* count every instruction (the block's num_insns) instead of bytes/4 */
+
+static void gen_symvm_block(TCGContext *tcg_ctx, void *uc, uint64_t pc)
+{
+    TCGv_i64 inc = tcg_const_i64(tcg_ctx, 0xf1f1f1f1);   /* patched: the clock cost of the block */
+    TCGv_ptr ctr = tcg_const_ptr(tcg_ctx, symvm_ctr);
+    TCGv_i64 count = tcg_temp_new_i64(tcg_ctx), limit = tcg_temp_new_i64(tcg_ctx);
+    TCGLabel *skip = gen_new_label(tcg_ctx);
+    tcg_gen_ld_i64(tcg_ctx, count, ctr, 0);
+    tcg_gen_add_i64(tcg_ctx, count, count, inc);
+    tcg_gen_st_i64(tcg_ctx, count, ctr, 0);
+    tcg_gen_ld_i64(tcg_ctx, limit, ctr, 8);
+    tcg_gen_brcond_i64(tcg_ctx, TCG_COND_LTU, count, limit, skip);
+    tcg_temp_free_i64(tcg_ctx, inc);
+    tcg_temp_free_ptr(tcg_ctx, ctr);
+    tcg_temp_free_i64(tcg_ctx, count);
+    tcg_temp_free_i64(tcg_ctx, limit);
+    gen_uc_tracecode(tcg_ctx, 0xf8f8f8f8, UC_HOOK_BLOCK_IDX, uc, pc);
+    gen_set_label(tcg_ctx, skip);
+}
+
 void translator_loop(const TranslatorOps *ops, DisasContextBase *db,
                      CPUState *cpu, TranslationBlock *tb, int max_insns)
 {
@@ -77,7 +101,8 @@ void translator_loop(const TranslatorOps *ops, DisasContextBase *db,
         ops->pc_sync(db, cpu);
         prev_op = tcg_last_op(tcg_ctx);
         block_hook = true;
-        gen_uc_tracecode(tcg_ctx, 0xf8f8f8f8, UC_HOOK_BLOCK_IDX, uc, db->pc_first);
+        if (symvm_ctr) gen_symvm_block(tcg_ctx, uc, db->pc_first);
+        else gen_uc_tracecode(tcg_ctx, 0xf8f8f8f8, UC_HOOK_BLOCK_IDX, uc, db->pc_first);
     }
 
     // tcg_dump_ops(tcg_ctx, false, "translator loop");
@@ -154,18 +179,16 @@ _end_loop:
         TCGOp *tcg_op;
 
         // Unicorn: patch the callback to have the proper block size.
-        if (prev_op) {
-            // As explained further up in the function where prev_op is
-            // assigned, we move forward in the tail queue, so we're modifying the
-            // move instruction generated by gen_uc_tracecode() that contains
-            // the instruction size to assign the proper size (replacing 0xF1F1F1F1).
-            tcg_op = QTAILQ_NEXT(prev_op, link);
-        } else {
-            // this basic block is the first emulated code ever,
-            // so the basic block operand is the first operand
-            tcg_op = QTAILQ_FIRST(&tcg_ctx->ops);
+        // symvm: the instruction count rides in the upper 16 bits (bytes stay in the lower), so a clock can count ARM and Thumb alike.
+        const uint32_t packed = db->tb->size | ((uint32_t)db->num_insns << 16);
+        for (tcg_op = prev_op ? QTAILQ_NEXT(prev_op, link) : QTAILQ_FIRST(&tcg_ctx->ops); tcg_op; tcg_op = QTAILQ_NEXT(tcg_op, link)) {
+            if (tcg_op->opc == INDEX_op_movi_i32 && tcg_op->args[1] == 0xf8f8f8f8) {
+                tcg_op->args[1] = packed;
+                break;
+            }
+            if (symvm_ctr && tcg_op->opc == INDEX_op_movi_i64 && tcg_op->args[1] == 0xf1f1f1f1) {
+                tcg_op->args[1] = symvm_exact_clock ? db->num_insns : (db->tb->size + 3) / 4;  /* default: the historic clock, bytes/4 (Thumb ticks at half rate) */
+            }
         }
-
-        tcg_op->args[1] = db->tb->size;
     }
 }
