+/* symvm: make every writable TLB entry that maps the host page behind code at `vaddr` notdirty again */
+void tlb_protect_code_host(CPUState *cpu, target_ulong vaddr)
+{
+    struct uc_struct *uc = cpu->uc;
+    CPUArchState *env = cpu->env_ptr;
+    int mmu_idx = cpu_mmu_index(env, true);
+    CPUTLBEntry *entry = tlb_entry(env, mmu_idx, vaddr);
+    if (!tlb_hit(uc, entry->addr_code, vaddr)) {
+        return;
+    }
+    tlb_reset_dirty(cpu, (vaddr & TARGET_PAGE_MASK) + entry->addend, TARGET_PAGE_SIZE);
+}
+
 void tlb_reset_dirty_by_vaddr(CPUState *cpu, target_ulong start1, target_ulong length)
 {
     struct uc_struct *uc = cpu->uc;
@@ -1209,7 +1222,7 @@ static void notdirty_write(CPUState *cpu, vaddr mem_vaddr, unsigned size,
     // - or doing snapshot
     // , then never clean the tlb
     if (!(!mr || (tlbe->addr_write != -1 && mr->priority < cpu->uc->snapshot_level)) &&
-            !(tlbe->addr_code != -1) &&
+            !page_has_tbs(cpu->uc, ram_addr) &&
             !uc_mem_hook_installed(cpu->uc, tlbe->paddr | (mem_vaddr & ~TARGET_PAGE_MASK))) {
         tlb_set_dirty(cpu, mem_vaddr);
     }
