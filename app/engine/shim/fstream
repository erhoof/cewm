// MSVC lets std::ifstream/ofstream open a std::wstring path; libstdc++ does not. Shadow <fstream> to add that.
#pragma once
#include_next <fstream>
#include <string>
#include "cerf_path.h"
namespace std {
inline std::string CerfNarrowPath(const std::wstring& w) {
    std::string s;
    for (wchar_t c : w) {
        uint32_t u = (uint32_t)c;
        if (u < 0x80) s += (char)u;
        else if (u < 0x800) { s += (char)(0xC0 | u >> 6); s += (char)(0x80 | (u & 63)); }
        else if (u < 0x10000) { s += (char)(0xE0 | u >> 12); s += (char)(0x80 | ((u >> 6) & 63)); s += (char)(0x80 | (u & 63)); }
        else { s += (char)(0xF0 | u >> 18); s += (char)(0x80 | ((u >> 12) & 63)); s += (char)(0x80 | ((u >> 6) & 63)); s += (char)(0x80 | (u & 63)); }
    }
    return s;
}
struct cerf_ifstream : std::ifstream {
    using std::ifstream::ifstream;
    explicit cerf_ifstream(const std::string& p, std::ios_base::openmode m = std::ios_base::in) : std::ifstream(CerfPosixPath(p), m) {}
    explicit cerf_ifstream(const char* p, std::ios_base::openmode m = std::ios_base::in) : std::ifstream(CerfPosixPath(p), m) {}
    explicit cerf_ifstream(const std::wstring& p, std::ios_base::openmode m = std::ios_base::in) : std::ifstream(CerfPosixPath(CerfNarrowPath(p)), m) {}
    explicit cerf_ifstream(const wchar_t* p, std::ios_base::openmode m = std::ios_base::in) : std::ifstream(CerfPosixPath(CerfNarrowPath(p)), m) {}
};
struct cerf_ofstream : std::ofstream {
    using std::ofstream::ofstream;
    explicit cerf_ofstream(const std::string& p, std::ios_base::openmode m = std::ios_base::out) : std::ofstream(CerfPosixPath(p), m) {}
    explicit cerf_ofstream(const char* p, std::ios_base::openmode m = std::ios_base::out) : std::ofstream(CerfPosixPath(p), m) {}
    explicit cerf_ofstream(const std::wstring& p, std::ios_base::openmode m = std::ios_base::out) : std::ofstream(CerfPosixPath(CerfNarrowPath(p)), m) {}
    explicit cerf_ofstream(const wchar_t* p, std::ios_base::openmode m = std::ios_base::out) : std::ofstream(CerfPosixPath(CerfNarrowPath(p)), m) {}
};
}  // namespace std
#define ifstream cerf_ifstream
#define ofstream cerf_ofstream
