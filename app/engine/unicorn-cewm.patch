+UNICORN_EXPORT uc_err cewm_uc_map_rom(uc_engine *uc, uint64_t base, uint64_t size,
+                                     void *ptr, uc_cb_mmio_write_t write_cb,
+                                     void *opaque)
+{
+    uc_err err = uc_mem_map_ptr(uc, base, size, UC_PROT_ALL, ptr);
+    if (err != UC_ERR_OK) return err;
+    MemoryRegion *mr = uc->memory_mapping(uc, base);
+    mmio_cbs *cbs = g_new0(mmio_cbs, 1);
+    cbs->write = write_cb;
+    cbs->user_data_write = opaque;
+    cbs->ops.write = mmio_write_wrapper;
+    cbs->ops.endianness = DEVICE_NATIVE_ENDIAN;
+    mr->ops = &cbs->ops;
+    mr->opaque = cbs;
+    mr->cewm_rom = true;
+    mr->destructor = cewm_rom_destructor;
+    tlb_flush(uc->cpu);
+    return UC_ERR_OK;
+}
