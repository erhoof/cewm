+/* CEWM: use QEMU's system exception entry, including MMU fault registers. */
+UNICORN_EXPORT void cewm_uc_exception(uc_engine *uc, int exception)
+{
+    CPUARMState *env = uc->cpu->env_ptr;
+    uc->cpu->exception_index = exception;
+    env->exception.target_el = 1;
+    if (exception == EXCP_PREFETCH_ABORT) {
+        env->cp15.dfsr_ns = env->exception.fsr;
+    }
+    /* ARMv5 exception vectors are ARM state; TE/EE are reserved on this CPU. */
+    uint64_t control = env->cp15.sctlr_ns;
+    env->cp15.sctlr_ns &= ~(SCTLR_TE | SCTLR_EE);
+    arm_cpu_do_interrupt(uc->cpu);
+    env->cp15.sctlr_ns = control;
+}
+
+UNICORN_EXPORT int cewm_uc_take_idle(uc_engine *uc)
+{
+    int halted = uc->cpu->halted;
+    uc->cpu->halted = 0;
+    return halted;
+}
+
+UNICORN_EXPORT void cewm_uc_configure(uc_engine *uc, uint32_t midr,
+                                    uint32_t ctr, int pc_store_extra,
+                                    int load_interwork)
+{
+    ARMCPU *cpu = ARM_CPU(uc->cpu);
+    ARMCPRegInfo *id = (ARMCPRegInfo *)get_arm_cp_reginfo(
+        cpu->cp_regs, ENCODE_CP_REG(15, 0, 1, 0, 0, 0, 0));
+    ARMCPRegInfo *cache = (ARMCPRegInfo *)get_arm_cp_reginfo(
+        cpu->cp_regs, ENCODE_CP_REG(15, 0, 1, 0, 0, 0, 1));
+    id->resetvalue = midr;
+    cache->resetvalue = ctr;
+    cpu->midr = midr;
+    cpu->env.cp15.c0_cpuid = midr;
+    cpu->ctr = ctr;
+    uc->cewm_configured = true;
+    uc->cewm_pc_store_extra = pc_store_extra;
+    uc->cewm_no_load_interwork = !load_interwork;
+}
